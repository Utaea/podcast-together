{
  "name": "podcast-together",
  "version": "0.10.4",
  "description": "一个基于 Vite + Vue + TypeScript + Cloudflare 的全栈项目，让你跟好友一起实时在线听播客！",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-force": "vite --force",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npx http-server -P http://127.0.0.1:${PORT} ./dist",
    "pages:build": "npm run build && cp config/pages/_redirects dist/_redirects",
    "pages:deploy": "npm run pages:build && npx wrangler pages deploy dist",
    "deploy": "npm run build && npm run cf:root:migrate && npx wrangler deploy",
    "cf:root:migrate": "npx wrangler d1 migrations apply DB --remote",
    "cf:worker:dev": "npm --prefix worker run dev",
    "cf:worker:typecheck": "npm --prefix worker run typecheck",
    "cf:worker:migrate": "npm --prefix worker run d1:migrate",
    "cf:worker:deploy": "npm --prefix worker run deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "nanoid": "^5.0.7",
    "pinia": "^3.0.3",
    "shikwasa2": "^2.3.0",
    "vconsole": "^3.15.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "weixin-js-sdk-ts": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "sass": "^1.74.1",
    "typescript": "^5.4.4",
    "user-agent-data-types": "^0.4.2",
    "vite": "^7.1.5",
    "vite-plugin-mkcert": "^1.17.5",
    "vite-plugin-pwa": "^1.0.3",
    "vue-tsc": "^3.0.7",
    "wrangler": "^4.35.0"
  },
  "contributors": [],
  "keywords": [
    "podcast",
    "播客",
    "vue",
    "web-socket",
    "shikwasa",
    "typescript",
    "cloudflare",
    "一起听播客",
    "实时连线"
  ],
  "license": "MIT"
}
