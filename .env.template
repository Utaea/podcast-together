# 前端环境变量配置文件模板
# 请新建一个 .env.local 文件，配置以下参数
# Cloudflare 建议：
#   VITE_API_URL=https://your-worker.your-domain.com
#   VITE_WEBSOCKET_URL=wss://your-worker.your-domain.com
# 连接房间时会自动拼接 /ws/:roomId

VITE_API_URL=你的后端应用 https 协议地址
VITE_WEBSOCKET_URL=你的后端应用 wss 协议地址

# 若干秒去回报一次心跳状态（选填，若不填请整行移除）
VITE_HEARTBEAT_PERIOD=15

# 项目链接（选填，不配置时相关入口会隐藏）
VITE_PROJECT_URL=
VITE_PROJECT_DISCUSSIONS_URL=

# Plausible
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# 联系方式（选填，不配置时相关入口仍可隐藏）
VITE_CONTACT_EMAIL=
VITE_CONTACT_FEISHU=
VITE_CONTACT_WECHAT=
